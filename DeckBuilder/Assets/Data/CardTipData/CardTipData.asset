%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4dfb350a262a12b4da85cbe040d6ae7f, type: 3}
  m_Name: CardTipData
  m_EditorClassIdentifier: 
  <Map>k__BackingField:
    _serializedList:
    - Key: BLOCK
      Value: Reduce incoming damage this turn.
    - Key: EXHAUST
      Value: Removes the card from your deck for the rest of this combat.
    - Key: BURN
      Value: Burned target loses HP at the beginning of their turn. Burn reduces
        by 1 after.
    - Key: DEXTERITY
      Value: Increases block gained from cards.
    - Key: FRAIL
      Value: Target appies 25% less block.
    - Key: STRENGTH
      Value: Target deals more damage on attacks.
    - Key: VULNERABLE
      Value: Target takes 50% more damage.
    - Key: WEAK
      Value: Target deals 25% less damage.
    - Key: LINGER
      Value: Effect activates if the card is in your hand when you end your turn.
    - Key: CHAOTIC
      Value: Effect activates if the hero has Chaos.
    - Key: CHAOS
      Value: Randomizes a number of targetted attack card effects.
    - Key: ADJACENT
      Value: Units to the immediate left, right, above or below are considered adjacent.
    - Key: ANCHORED
      Value: Target is immune to movement from other units for a number of turns.
    - Key: HAMSTRUNG
      Value: Target can't move itself for a number of turns.
    - Key: ALIGNED
      Value: A unit is aligned if it is in the same lane as you
    - Key: GAURD
      Value: Unit remains in the front of the lane potentially blocking enemy attacks.
